---
// Section shell: id from the veon-concept `sections` list, optional data-rec link to recommendations.
interface Props { id: string; rec?: string; class?: string; label?: string; }
const { id, rec, class: cls, label } = Astro.props;
---
<section id={id} data-rec={rec} class={cls} aria-label={label}>
  <slot />
</section>
