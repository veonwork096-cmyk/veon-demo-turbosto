---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
const B = import.meta.env.BASE_URL;

interface Props { lang: string; title: string; description: string; canonical?: string; mainRec?: string; }
const { lang, title, description, canonical, mainRec } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${B}images/master-turbines-16x9-1280.webp`, Astro.site ?? Astro.url).href} />
    <meta name="theme-color" content="#E8EAEB" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={B + "images/favicon.svg"} type="image/svg+xml" />
    <link rel="preload" href={B + "fonts/tektur-cyrillic.woff2"} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>
      /* Floor 4 (also in global.css): clip, never hidden, so the sticky header keeps working. */
      html, body { overflow-x: clip; }
    </style>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec={mainRec}><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/page.ts"></script>
  </body>
</html>
